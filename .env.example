# ── Data ──────────────────────────────────────────────
# kraken (default, public, no key) or binance (public, geo-restricted in some regions)
PROVIDER=kraken
# comma-separated pairs (kraken format, e.g. XBTUSD,ETHUSD,SOLUSD)
PAIRS=XBTUSD,ETHUSD
# base timeframe in minutes (strategy is tuned for 15)
TIMEFRAME=15
# bypass disk cache
FRESH=false

# ── Strategy ──────────────────────────────────────────
# classic UT Bot (fixed ATR trail) vs adaptive engine
CLASSIC_UT=false
# hard confirmation filters
USE_ADX=true
ADX_MIN=12
USE_EMA_TREND=true
USE_VWAP=true
USE_MTF=true
# market-regime guard: block new signals while BTC 15m ADX is below the floor (chop shutdown)
USE_REGIME=true
REGIME_ADX_MIN=10
USE_VOLUME=true
VOL_MIN=1.0
USE_FULL_CANDLE=false
USE_ZONE_FILTER=true
USE_VOLATILITY=true
COOLDOWN_BARS=2
TWO_BAR_CONFIRM=true
MIN_CONFIDENCE=40

# ── Risk ──────────────────────────────────────────────
EQUITY=10000
RISK_PCT=1
# structural | atr | scaled | smart | safer | percent
SL_METHOD=structural
HUNT_MULT=0.5
ATR_MULT=1.3
TP_CHOICE=2
FEE_BPS=5

# ── Notifications ─────────────────────────────────────
# leave empty to log signals to console only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Live / dashboard ──────────────────────────────────
POLL_SEC=60
DASH_PORT=8080
