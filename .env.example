# ── Data ──────────────────────────────────────────────
# kraken (default, public, no key) or binance (public, geo-restricted in some regions)
PROVIDER=kraken
# comma-separated pairs (kraken format, e.g. XBTUSD,ETHUSD,SOLUSD)
PAIRS=XBTUSD,ETHUSD
# base timeframe in minutes (strategy auto-picks a style preset from this)
TIMEFRAME=15
# bypass disk cache
FRESH=false

# ── Trading style ─────────────────────────────────────
# auto (from TIMEFRAME) | scalping | day | swing | position | custom
STYLE=auto
# custom-style overrides (only when STYLE=custom; day-trading defaults shown)
UT_KEY=1.5
UT_ATR=10
CHOP=1.0
# classic UT Bot (fixed ATR trail) vs adaptive engine
CLASSIC_UT=false
# strict (our default: most filters ON) | lux (Ali's out-of-box: optional filters OFF)
FILTER_PRESET=strict

# ── Hard confirmation filters ─────────────────────────
USE_REGIME=true
REGIME_ADX_MIN=10
USE_ADX=true
ADX_MIN=12
USE_EMA_TREND=true
USE_VWAP=true
USE_MTF=true
MTF_MIN_AGREE=0.5
USE_VOLUME=true
VOL_MIN=1.0
USE_FULL_CANDLE=false
USE_ZONE_FILTER=true
USE_VOLATILITY=true
USE_STRUCTURE=true
USE_RSI_FILTER=false
USE_SUPERTREND_FILTER=false
USE_HULL_FILTER=false
COOLDOWN_BARS=2
# confirmation bars (0 = auto from TWO_BAR_CONFIRM: true->2, false->1)
CONFIRM_BARS=0
TWO_BAR_CONFIRM=true
MIN_CONFIDENCE=40
# trend-duration forecast engine: simple (median) | standard (EWMA) | advanced (+5 multipliers)
FORECAST_MODE=standard

# ── Risk ──────────────────────────────────────────────
EQUITY=10000
RISK_PCT=1
# structural | atr | scaled | smart | safer | percent | tick
SL_METHOD=structural
HUNT_MULT=0.5
ATR_MULT=1.3
# price steps for the tick method (tick size auto-derived from price magnitude)
SL_TICKS=200
TP_CHOICE=2
FEE_BPS=5

# ── Notifications ─────────────────────────────────────
# leave empty to log signals to console only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Live / dashboard ──────────────────────────────────
POLL_SEC=60
DASH_PORT=8080
